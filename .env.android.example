# Android deployment environment selector
# Valid values: stage, production
BUILD_TYPE=production

# Stage and production base URLs used for Android app BuildConfig and APK metadata URLs.
ANDROID_STAGE_BASE_URL=https://brother-pharmach-mdm-stage.space
ANDROID_PROD_BASE_URL=https://brothers-mdm.com

# Optional explicit override. If set, this wins over BUILD_TYPE selection.
# ANDROID_BASE_URL=https://brothers-mdm.com

# Optional secondary URL fallback in the app. Defaults to ANDROID_BASE_URL.
# ANDROID_SECONDARY_BASE_URL=https://brothers-mdm.com
