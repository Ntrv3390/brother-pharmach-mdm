<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="SetupWizardTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/wizardPrimary</item>
        <item name="colorPrimaryDark">@color/wizardPrimaryDark</item>
        <item name="colorAccent">@color/wizardAccent</item>
    </style>

    <!-- Dial pad row / key styling (used by activity_dialpad.xml). -->
    <style name="DialpadRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <!-- One key: a vertical box holding the big digit and its small letters. -->
    <style name="DialpadKeyBox">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
    </style>

    <style name="DialpadDigit">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#111111</item>
        <item name="android:textSize">28sp</item>
    </style>

    <style name="DialpadLetters">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#8A9199</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.15</item>
        <item name="android:minHeight">12dp</item>
    </style>

    <!-- Fullscreen, no-action-bar theme for the incoming/in-call screen. Uses a plain framework
         parent (not AppCompat) so IncomingCallActivity can extend android.app.Activity and render
         reliably over the keyguard on API 23-36. -->
    <style name="IncomingCallTheme" parent="@android:style/Theme.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
    </style>

</resources>
