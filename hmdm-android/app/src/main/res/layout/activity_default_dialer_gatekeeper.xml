<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ Brother Pharmamach MDM: blocking gatekeeper shown until the app is the default phone app.
  -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gatekeeper_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E1621"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_call_avatar"
            android:padding="22dp"
            android:src="@drawable/ic_call_answer"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialer_gatekeeper_title"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/dialer_gatekeeper_message"
            android:textColor="#B0BEC5"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"
            android:gravity="center" />

        <Button
            android:id="@+id/btn_set_default_dialer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="@string/dialer_gatekeeper_set_default"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="#2E7D32"
            android:padding="16dp" />

        <Button
            android:id="@+id/btn_open_default_apps_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/dialer_gatekeeper_open_settings"
            android:textColor="#B0BEC5"
            android:background="#1E2A38"
            android:padding="16dp" />
    </LinearLayout>
</ScrollView>
