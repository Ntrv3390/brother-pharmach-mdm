<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ Brother Pharmamach MDM: full-screen incoming / in-call UI shown when the app holds the
  ~ default-dialer role. Kept dependency-free (FrameLayout/LinearLayout) so it renders under a
  ~ plain non-AppCompat fullscreen theme on API 23 through 36.
  -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E1621">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="96dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:background="@drawable/bg_call_avatar"
            android:padding="24dp"
            android:src="@drawable/ic_call_person"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/call_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/incoming_call_title"
            android:textColor="#B0BEC5"
            android:textSize="16sp"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/caller_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/unknown_caller"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/caller_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#90A4AE"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- In-call secondary controls (mute / speaker), only while a call is active -->
    <LinearLayout
        android:id="@+id/in_call_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="160dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="32dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btn_mute"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_call_control"
                android:src="@drawable/ic_call_mute"
                android:contentDescription="@string/mute" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/mute"
                android:textColor="#B0BEC5"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btn_speaker"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_call_control"
                android:src="@drawable/ic_call_speaker"
                android:contentDescription="@string/speaker" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/speaker"
                android:textColor="#B0BEC5"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Primary answer / decline / end row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="56dp"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/answer_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btn_answer"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/bg_call_answer"
                android:src="@drawable/ic_call_answer"
                android:contentDescription="@string/answer" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/answer"
                android:textColor="#B0BEC5"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/decline_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btn_decline"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/bg_call_decline"
                android:src="@drawable/ic_call_end"
                android:contentDescription="@string/decline" />

            <TextView
                android:id="@+id/decline_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/decline"
                android:textColor="#B0BEC5"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
