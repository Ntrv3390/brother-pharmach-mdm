<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ Brother Pharmamach MDM: dial pad for placing outgoing calls while the app is the default phone
  ~ app. Dependency-free (LinearLayout) so it renders under the plain AppTheme on API 23-36.
  -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E1621"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="24dp">

    <!-- Dialed number + backspace -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/dial_number"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:hint="@string/dialpad_hint"
            android:textColorHint="#4A5A68"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:maxLines="1"
            android:ellipsize="start" />

        <ImageButton
            android:id="@+id/dial_backspace"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_dial_backspace"
            android:visibility="invisible"
            android:contentDescription="@string/dialpad_delete" />
    </LinearLayout>

    <!-- Keypad -->
    <LinearLayout style="@style/DialpadRow">
        <TextView android:id="@+id/key_1" style="@style/DialpadKey" android:text="1"/>
        <TextView android:id="@+id/key_2" style="@style/DialpadKey" android:text="2"/>
        <TextView android:id="@+id/key_3" style="@style/DialpadKey" android:text="3"/>
    </LinearLayout>
    <LinearLayout style="@style/DialpadRow">
        <TextView android:id="@+id/key_4" style="@style/DialpadKey" android:text="4"/>
        <TextView android:id="@+id/key_5" style="@style/DialpadKey" android:text="5"/>
        <TextView android:id="@+id/key_6" style="@style/DialpadKey" android:text="6"/>
    </LinearLayout>
    <LinearLayout style="@style/DialpadRow">
        <TextView android:id="@+id/key_7" style="@style/DialpadKey" android:text="7"/>
        <TextView android:id="@+id/key_8" style="@style/DialpadKey" android:text="8"/>
        <TextView android:id="@+id/key_9" style="@style/DialpadKey" android:text="9"/>
    </LinearLayout>
    <LinearLayout style="@style/DialpadRow">
        <TextView android:id="@+id/key_star" style="@style/DialpadKey" android:text="*"/>
        <TextView android:id="@+id/key_0" style="@style/DialpadKey" android:text="0"/>
        <TextView android:id="@+id/key_hash" style="@style/DialpadKey" android:text="#"/>
    </LinearLayout>

    <!-- Call button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/dial_call"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_call_answer"
            android:src="@drawable/ic_call_answer"
            android:contentDescription="@string/dialpad_call" />
    </LinearLayout>
</LinearLayout>
