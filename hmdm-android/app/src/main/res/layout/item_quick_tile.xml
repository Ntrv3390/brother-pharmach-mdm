<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <FrameLayout
        android:id="@+id/qp_tile_circle"
        android:layout_width="@dimen/qp_tile_circle_size"
        android:layout_height="@dimen/qp_tile_circle_size"
        android:background="@drawable/bg_qp_tile_inactive">

        <ImageView
            android:id="@+id/qp_tile_icon"
            android:layout_width="@dimen/qp_tile_icon_size"
            android:layout_height="@dimen/qp_tile_icon_size"
            android:layout_gravity="center"/>
    </FrameLayout>

    <TextView
        android:id="@+id/qp_tile_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/qpTextPrimary"
        android:textSize="@dimen/qp_label_text_size"/>
</LinearLayout>
